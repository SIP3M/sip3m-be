generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusPencairanDana {
  DISETUJUI
  MENUNGGU_PERSETUJUAN
  TERCAIRKAN
  DITOLAK
}

enum SkemaProposal {
  PENELITIAN_PENGEMBANGAN @map("Penelitian Pengembangan")
  PENELITIAN_TERAPAN      @map("Penelitian Terapan")
  PENELITIAN_KOLABORASI   @map("Penelitian Kolaborasi")
}

enum SumberPendanaan {
  INTERNAL_KAMPUS  @map("Internal Kampus")
  KEMENDIKBUDRISTEK @map("Kemendikbudristek")
  MANDIRI          @map("Mandiri")
  LAINNYA          @map("Lainnya")
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  ADMIN_VERIFIED
  UNDER_REVIEW
  REVISION
  REVISION_PENDING
  ACCEPTED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  REVISION_MINOR
  REVISION_MAJOR
}

enum PengabdianStatus {
  SEDANG_BERJALAN
  PENDING
  SELESAI
}

enum PengabdianMilestoneStatus {
  PENDING
  ONGOING
  COMPLETED
  OVERDUE
}

enum PengabdianDocumentType {
  DOKUMEN_KONTRAK
  LAPORAN_KEMAJUAN_1
  LAPORAN_KEMAJUAN_2
  LAPORAN_AKHIR
  LOGBOOK_KEGIATAN
  BUKTI_PENGGUNAAN_ANGGARAN
  LAINNYA
}

enum DocumentVerificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum JenisKkm {
  REGULER
  TEMATIK
}

enum KkmPeriodStatus {
  DRAFT
  AKTIF
  DIJADWALKAN
  SELESAI
}

model proposals {
  id                     Int            @id @default(autoincrement())
  title                  String         @db.VarChar(255)
  lead_researcher_id     Int            @db.Integer
  faculty                String?        @db.VarChar(100)
  funding_request_amount Int            @db.Integer
  status                 ProposalStatus @default(DRAFT)

  skema              SkemaProposal
  sumber_pendanaan   SumberPendanaan?
  proposal_file_path String? @db.VarChar(255)
  rab_file_path      String? @db.VarChar(255)

  dosen_terlibat         String?        @db.Text 
  nidn_dosen_terlibat    String?        @db.Text
  nama_anggota           String?        @db.Text
  nim_anggota            String?        @db.Text
  nama_ketua             String?        @db.VarChar(100)
  nidn_ketua             String?        @db.VarChar(30)

  sumber_data_penelitian String?        @db.Text
  detail_sumber_penelitian String?      @db.Text
  instansi               String?        @db.VarChar(255)

  submitted_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user    users             @relation(fields: [lead_researcher_id], references: [id])
  reviews ProposalReviews[]
  reviewers ProposalReviewers[]
  pengabdianProject PengabdianProjects?

  @@index([lead_researcher_id])
  @@index([status])
}

model ProposalReviews {
  id          Int            @id @default(autoincrement())
  proposal_id Int
  reviewer_id Int 
  status      ProposalStatus 
  notes       String?        @db.Text
  created_at  DateTime       @default(now())
  completed_at DateTime?

  // perhitungan nilai per point
  score_perumusan   Float? 
  score_tinjauan    Float? 
  score_metode      Float? 
  score_anggaran    Float? 
  score_luaran      Float? 
  total_score       Float? 
  
  // catatan per point
  catatan_perumusan   String? @db.Text
  catatan_tinjauan    String? @db.Text
  catatan_metode      String? @db.Text
  catatan_anggaran    String? @db.Text
  catatan_luaran      String? @db.Text
  
  // catatan umum
  kekuatan_proposal String? @db.Text
  kelemahan_proposal String? @db.Text
  rekomendasi_akhir  String? @db.VarChar(50)

  // keputusan reviewer (BARU)
  decision ReviewDecision?
  
  // revision tracking (BARU)
  revision_count Int @default(0)
  revision_deadline DateTime?
  last_revision_submitted_at DateTime?

  proposal proposals @relation(fields: [proposal_id], references: [id])
  reviewer users     @relation(fields: [reviewer_id], references: [id])
}

model Notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  message    String   @db.Text 
  is_read    Boolean  @default(false) 
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id])
}

model roles {
  id    Int     @id @default(autoincrement())
  roles String  @unique(map: "roles_name_key") @db.VarChar(50)
  users users[]
}

model schema_migrations {
  version BigInt  @id
  dirty   Boolean
}

model Fakultas {
  id            Int            @id @default(autoincrement())
  nama          String         @unique @db.VarChar(100)
  program_studi ProgramStudi[]
  
  // Relasi opsional jika user langsung di-bind ke ID fakultas
  users users[] 
}

model ProgramStudi {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(100)
  fakultas_id Int
  fakultas    Fakultas @relation(fields: [fakultas_id], references: [id], onDelete: Cascade)
  
  // Relasi opsional jika user langsung di-bind ke ID prodi
  users users[]
}

model users {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  email         String  @unique @db.VarChar(100)
  username      String? @unique @db.VarChar(50)
  password_hash String
  role_id       Int

  nidn_nip      String? @unique @db.VarChar(30)
  // fakultas      String? @db.VarChar(100)
  // program_studi String? @db.VarChar(100)

  fakultas_id      Int?
  program_studi_id Int?

  Fakultas     Fakultas?     @relation(fields: [fakultas_id], references: [id])
  ProgramStudi ProgramStudi? @relation(fields: [program_studi_id], references: [id])

  tempat_lahir  String?   @db.VarChar(100)
  tanggal_lahir DateTime? @db.Date
  jenis_kelamin String?   @db.VarChar(15)
  alamat        String?   @db.Text
  nomor_hp      String?   @db.VarChar(20)

  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  proposals proposals[]

  instansi          String?           @db.VarChar(100)
  bidang_keahlian   String?           @db.VarChar(100)
  pengalaman_review String?           @db.Text
  cv_path           String?           @db.VarChar(255)
  proposalReviews   ProposalReviews[]
  notifications     Notifications[]
  reviewers ProposalReviewers[]
  pengabdianDocumentsUploaded PengabdianDocuments[] @relation("UploadedByUser")
  kkmPeriodsCreated        KkmPeriod[]
  kkmLocationsCreated      KkmLocation[]
  dplKelompok              KkmKelompok[]       @relation("DplKelompok")
  dplQuotas                KkmDplQuota[]

  @@index([role_id])
}

model ProposalReviewers {
  id          Int       @id @default(autoincrement())
  proposal_id Int
  reviewer_id Int
  created_at  DateTime  @default(now())

  proposal    proposals @relation(fields: [proposal_id], references: [id])
  reviewer    users     @relation(fields: [reviewer_id], references: [id])

  @@unique([proposal_id, reviewer_id]) 
}

model PengabdianProjects {
  id               Int              @id @default(autoincrement())
  proposal_id      Int              @unique
  project_code     String?          @unique @db.VarChar(30)
  title            String?          @db.VarChar(255)
  summary          String?          @db.Text
  start_date       DateTime?        @db.Date
  end_date         DateTime?        @db.Date
  overall_progress Int              @default(0)
  status           PengabdianStatus @default(PENDING)
  is_archived      Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  disbursement_status StatusPencairanDana @default(MENUNGGU_PERSETUJUAN)
  realized_amount     Int?               @default(0) 
  disbursed_at        DateTime?          

  proposal proposals @relation(fields: [proposal_id], references: [id])

  milestones PengabdianMilestones[]
  documents  PengabdianDocuments[]

  @@index([status])
  @@index([is_archived])
}

model PengabdianMilestones {
  id                Int                       @id @default(autoincrement())
  project_id        Int
  title             String                    @db.VarChar(255)
  description       String?                   @db.Text
  sequence          Int
  target_percentage Int                       @default(0)
  due_date          DateTime?                 @db.Date
  status            PengabdianMilestoneStatus @default(PENDING)
  completed_at      DateTime?
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @updatedAt

  project PengabdianProjects @relation(fields: [project_id], references: [id], onDelete: Cascade)

  documents PengabdianDocuments[]

  @@unique([project_id, sequence])
  @@index([project_id])
  @@index([status])
}

model PengabdianDocuments {
  id                  Int                        @id @default(autoincrement())
  project_id          Int
  milestone_id        Int?
  document_type       PengabdianDocumentType
  title               String?                    @db.VarChar(255)
  file_path           String                     @db.VarChar(500)
  file_size           Int?
  mime_type           String?                    @db.VarChar(100)
  verification_status DocumentVerificationStatus @default(PENDING)
  verification_notes  String?                    @db.Text
  uploaded_by         Int
  uploaded_at         DateTime                   @default(now())

  project    PengabdianProjects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestone  PengabdianMilestones? @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  uploader   users                @relation("UploadedByUser", fields: [uploaded_by], references: [id])

  @@index([project_id])
  @@index([milestone_id])
  @@index([document_type])
  @@index([verification_status])
}

model KkmPeriod {
  id                      Int             @id @default(autoincrement())
  nama_periode            String          @db.VarChar(150)
  tahun_akademik          String          @db.VarChar(9)
  tahun                   Int
  jenis                   JenisKkm
  deskripsi               String?         @db.Text

  tgl_buka_daftar         DateTime?       @db.Date
  tgl_tutup_daftar        DateTime?       @db.Date
  tgl_pembekalan          DateTime?       @db.Date
  tgl_pelaksanaan         DateTime?       @db.Date
  tgl_penarikan           DateTime?       @db.Date
  deadline_laporan        DateTime?       @db.Date

  target_peserta          Int             @default(0)
  minimal_semester        Int?
  maks_anggota_kelompok   Int             @default(10)
  boleh_lintas_fakultas   Boolean         @default(false)
  wajib_campur_prodi      Boolean         @default(false)

  assign_dpl_otomatis     Boolean         @default(false)
  maks_kelompok_per_dosen Int?

  status                  KkmPeriodStatus @default(DRAFT)

  created_by              Int?
  creator                 users?          @relation(fields: [created_by], references: [id])
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt

  locations   KkmLocation[]
  kelompokan  KkmKelompok[]
  dplQuotas   KkmDplQuota[]

  @@unique([nama_periode, tahun_akademik])
  @@index([status])
  @@index([tahun_akademik])
  @@index([tahun])
  @@index([jenis])
}

model KkmDplQuota {
  id                Int      @id @default(autoincrement())
  periode_id        Int
  dosen_id          Int
  maksimal_kelompok Int

  periode           KkmPeriod @relation(fields: [periode_id], references: [id], onDelete: Cascade)
  dosen             users     @relation(fields: [dosen_id], references: [id], onDelete: Cascade)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([periode_id, dosen_id])
  @@index([periode_id])
  @@index([dosen_id])
}

model KkmLocation {
  id         Int      @id @default(autoincrement())
  periode_id Int
  kabupaten  String   @db.VarChar(100)
  kecamatan  String   @db.VarChar(100)
  desa       String   @db.VarChar(100)
  kuota      Int

  // terisi & status Penuh/Tersedia = derived (hitungan kelompok/peserta), bukan kolom

  created_by Int?
  creator    users?     @relation(fields: [created_by], references: [id])
  periode    KkmPeriod  @relation(fields: [periode_id], references: [id], onDelete: Cascade)
  kelompok   KkmKelompok?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@unique([periode_id, kabupaten, kecamatan, desa])
  @@index([periode_id])
  @@index([kecamatan])
  @@index([kabupaten])
}

model KkmKelompok {
  id         Int      @id @default(autoincrement())
  periode_id Int
  lokasi_id  Int      @unique
  nama       String   @db.VarChar(50)
  dpl_id     Int?

  periode    KkmPeriod   @relation(fields: [periode_id], references: [id], onDelete: Cascade)
  lokasi     KkmLocation @relation(fields: [lokasi_id], references: [id], onDelete: Cascade)
  dpl        users?      @relation("DplKelompok", fields: [dpl_id], references: [id], onDelete: SetNull)

  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@index([periode_id])
  @@index([dpl_id])
  @@index([periode_id, dpl_id])
}
